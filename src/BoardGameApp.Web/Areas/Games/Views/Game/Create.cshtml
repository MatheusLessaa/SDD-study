@model GameCreateViewModel

<section class="form-shell">
    <div class="form-card">
        <header class="form-card-header">
            <h2>Add Game</h2>
            <p>Create a board game profile for match tracking.</p>
        </header>

        <form asp-action="Create" method="post" class="entity-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-field">
                <label asp-for="Name">Name</label>
                <input asp-for="Name" placeholder="Terraforming Mars" autofocus />
                <span asp-validation-for="Name" class="field-validation"></span>
            </div>

            <div class="form-field">
                <label asp-for="AuthorId">Author</label>
                <select asp-for="AuthorId">
                    <option value="">Select an author</option>
                    <option value="1">Michael Kiesling</option>
                    <option value="2">Klaus Teuber</option>
                    <option value="3">Jacob Fryxelius</option>
                </select>
                <span asp-validation-for="AuthorId" class="field-validation"></span>
            </div>

            <div class="form-grid two-columns">
                <div class="form-field">
                    <label asp-for="PublisherId">Publisher</label>
                    <select asp-for="PublisherId">
                        <option value="">Select a publisher</option>
                        @foreach (var publisher in Model.PublisherOptions)
                        {
                            <option value="@publisher.Id">@publisher.Name</option>
                        }
                    </select>
                    <span asp-validation-for="PublisherId" class="field-validation"></span>
                </div>

                <div class="form-field">
                    <label asp-for="GenreId">Genre</label>
                    <select asp-for="GenreId">
                        <option value="">Select a genre</option>
                        @foreach (var genre in Model.GenreOptions)
                        {
                            <option value="@genre.Id">@genre.Name</option>
                        }
                    </select>
                    <span asp-validation-for="GenreId" class="field-validation"></span>
                </div>
            </div>

            <div class="form-field">
                <label asp-for="MaxPlayers">Max Players</label>
                <input asp-for="MaxPlayers" type="number" min="1" />
                <span asp-validation-for="MaxPlayers" class="field-validation"></span>
            </div>

            <div class="form-actions">
                <a class="secondary-button" asp-action="Index">Cancel</a>
                <button class="primary-button" type="submit">
                    <span class="material-symbols-outlined" aria-hidden="true">add</span>
                    <span>Create Game</span>
                </button>
            </div>
        </form>
    </div>
</section>
