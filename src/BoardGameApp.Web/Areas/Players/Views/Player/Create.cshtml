@model CreatePlayerDto

<section class="form-shell">
    <div class="form-card">
        <header class="form-card-header">
            <h2>Add New Player</h2>
            <p>Create a player profile for match tracking.</p>
        </header>

        <form asp-action="Create" method="post" class="entity-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-field">
                <label asp-for="FullName">Full name</label>
                <input asp-for="FullName" placeholder="Alexander Smith" autofocus />
                <span asp-validation-for="FullName" class="field-validation"></span>
            </div>

            <div class="form-field">
                <label asp-for="WhatsApp">WhatsApp</label>
                <input asp-for="WhatsApp" placeholder="(32) 9 1111-1111" type="tel" inputmode="numeric" maxlength="16" pattern="\(\d{2}\) (\d{4}-\d{4}|9 \d{4}-\d{4})" data-brazilian-phone />
                <span asp-validation-for="WhatsApp" class="field-validation"></span>
            </div>

            <div class="form-actions">
                <a class="secondary-button" asp-action="Index">Cancel</a>
                <button class="primary-button" type="submit">
                    <span class="material-symbols-outlined" aria-hidden="true">person_add</span>
                    <span>Create Player</span>
                </button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/js/player-phone-mask.js" asp-append-version="true"></script>
}
